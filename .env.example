# Copy this file to .env (local) or set these in your host environment.

# Base URL of the self-hosted vLLM OpenAI-compatible endpoint.
# Example: http://127.0.0.1:8000
# Leave empty/undefined to run in "mock" mode (built-in rule-based scorer).
VLLM_BASE_URL=

# Model name as served by vLLM. Only used when VLLM_BASE_URL is set.
# Default: Qwen/Qwen3-4B
VLLM_MODEL=Qwen/Qwen3-4B
